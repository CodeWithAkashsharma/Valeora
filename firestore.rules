rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@valeora.com' ||
        request.auth.token.email == 'valeora.shop@gmail.com' ||
        request.auth.token.email.matches('admin@.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // =====================================================
    // PRODUCTS — Public read, admin write only
    // =====================================================
    match /products/{productId} {
      allow read: if true;                     // Anyone (even guests) can browse products
      allow write: if isAdmin();               // Only admins can add/update/delete products
    }

    // =====================================================
    // COUPONS — Public read, admin write only
    // =====================================================
    match /coupons/{couponId} {
      allow read: if true;                     // Anyone can read coupons (to validate at checkout)
      allow write: if isAdmin();               // Only admins can manage coupons
    }

    // =====================================================
    // ORDERS — Users see their own, admins see all
    // =====================================================
    match /orders/{orderId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && (
                       resource.data.userId == request.auth.uid ||
                       resource.data.email == request.auth.token.email
                     ));
      allow create: if true;                   // Anyone (guest checkout included) can place orders
      allow update: if isAdmin();              // Only admins can update order status
      allow delete: if isAdmin();
    }

    // =====================================================
    // QUERIES (Support) — Users create, admins manage
    // =====================================================
    match /queries/{queryId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if true;                   // Anyone can submit a support query
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // USERS — Each user reads/writes their own; admins see all
    // =====================================================
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // =====================================================
    // RETURNS — Users create, admins manage
    // =====================================================
    match /returns/{returnId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
